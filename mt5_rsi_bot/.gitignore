# .env holds broker credentials. run.sh creates it automatically, so without
# this rule the first person to run the bot commits their MT5 password.
.env

venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Market data pulled for backtesting. Not committed: it is a vendor's data and
# redistribution terms are theirs to set, not ours. See artifacts/BACKTEST-REPORT.md
# for how to obtain it.
data/
