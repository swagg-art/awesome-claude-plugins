# Copy to .env and edit. run.sh loads it automatically.
#
# Two prefixes:
#   MT5_RSI_*     the strategy and its risk budget
#   NATIVE_MT5_*  the broker connection and the hard safety caps
#
# The defaults below are deliberately timid: mock data, paper orders, half a
# percent per trade. Change them one at a time and read the logs in between.

# ===========================================================================
# Broker connection
# ===========================================================================
# mock     synthetic data, no broker, runs anywhere — use this first
# terminal a real MetaTrader 5 terminal (needs the MetaTrader5 package)
NATIVE_MT5_ADAPTER=mock

# readonly the bot refuses to start (it could never trade) unless DRY_RUN=true
# paper    orders are simulated, nothing reaches a broker
# live     REAL ORDERS, REAL MONEY
NATIVE_MT5_MODE=paper

# Leave blank to attach to a terminal that is already logged in.
NATIVE_MT5_LOGIN=
NATIVE_MT5_PASSWORD=
NATIVE_MT5_SERVER=
NATIVE_MT5_TERMINAL_PATH=

# Tags this bot's orders so they are distinguishable in the terminal.
NATIVE_MT5_MAGIC=777001

# ===========================================================================
# Hard caps — the bot cannot exceed these, whatever the strategy asks for
# ===========================================================================
NATIVE_MT5_MAX_RISK_PER_TRADE_PCT=1.0
NATIVE_MT5_MAX_ORDER_VOLUME=1.0
NATIVE_MT5_MAX_OPEN_POSITIONS=3
# Comma separated. Strongly recommended: pin the bot to the symbol it trades.
NATIVE_MT5_SYMBOL_ALLOWLIST=EURUSD

# ===========================================================================
# Instrument
# ===========================================================================
MT5_RSI_SYMBOL=EURUSD
# M1 M5 M15 M30 H1 H4 D1 W1 MN1
MT5_RSI_TIMEFRAME=M15

# ===========================================================================
# Signal
# ===========================================================================
MT5_RSI_RSI_PERIOD=14
MT5_RSI_RSI_OVERSOLD=30
MT5_RSI_RSI_OVERBOUGHT=70

# Optional trend filter: only buy above the EMA, only sell below it. 0 = off.
# Mean reversion into a strong trend is where this kind of strategy bleeds, so
# try 200 before concluding the strategy does not work.
MT5_RSI_EMA_TREND_PERIOD=0

# ===========================================================================
# Stops and targets, in multiples of ATR so they scale with volatility
# ===========================================================================
MT5_RSI_ATR_PERIOD=14
MT5_RSI_ATR_STOP_MULTIPLE=2.0
MT5_RSI_ATR_TARGET_MULTIPLE=3.0

# ===========================================================================
# Risk
# ===========================================================================
# Per trade, as a percentage of balance. Must not exceed the cap above.
MT5_RSI_RISK_PCT=0.5

# The kill switch. Once the day is this far down from its opening equity, the
# bot opens nothing new until UTC midnight. Open positions keep their stops.
MT5_RSI_MAX_DAILY_LOSS_PCT=2.0

# ===========================================================================
# Loop
# ===========================================================================
MT5_RSI_POLL_SECONDS=30
MT5_RSI_CANDLE_COUNT=200

# Log signals and sizing but never send an order. The safest way to watch a
# new configuration for a few days before letting it trade.
MT5_RSI_DRY_RUN=false
