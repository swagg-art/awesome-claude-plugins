# Copy to .env and edit. run.sh does this for you on first start.

# ===========================================================================
# Account
# ===========================================================================
# Leave all three blank to use whatever account the terminal is already logged
# into. If you set one you must set all three.
MT5_LOGIN=12345678
MT5_PASSWORD=YourPasswordHere
MT5_SERVER=Broker-ServerName

MT5_SYMBOL=BTCUSD
# M1 M5 M15 M30 H1 H4 D1 W1 MN1
MT5_TIMEFRAME=M15

# ===========================================================================
# Order
# ===========================================================================
LOT_SIZE=0.01
MAGIC_NUMBER=123456
DEVIATION=20

# ===========================================================================
# Strategy
# ===========================================================================
# confirmed (default) — RSI reaching an extreme, or diverging from price, only
#   ARMS a setup. Nothing is traded until price agrees: a reversal candlestick
#   pattern AND a close beyond the previous bar's extreme, within
#   CONFIRM_WITHIN_BARS. Roughly 75% of armed setups never confirm and are
#   discarded. Stops come from the swing the setup formed on, plus an ATR
#   buffer; the target is a multiple of that distance. Nothing is a fixed
#   percentage.
#
# simple — the original: RSI crossing back through a fixed threshold, with
#   fixed-percent stops. Backtested at profit factor 0.53 on BTC daily.
#   Kept only for comparison. Do not trade it.
#
# Measured on BTC/USD daily 2018-2026 (see artifacts/STRATEGY-V2-REPORT.md):
# removing the candle pattern requirement takes profit factor from 1.19 to
# 0.32. Removing the close-beyond-prior-bar takes it to 0.40. Both are load
# bearing; neither works alone.
STRATEGY=confirmed

# Arm only on RSI divergence, ignoring plain oversold/overbought. Fewer and
# generally better setups.
DIVERGENCE_ONLY=false

# How long an armed setup waits for confirmation before it is discarded.
CONFIRM_WITHIN_BARS=5

# Target as a multiple of the stop distance. 3 means a winner pays three times
# what a loser costs, which is what makes a ~30% win rate profitable.
REWARD_MULTIPLE=3.0

# How far beyond the swing the stop sits, in ATR. Keeps ordinary noise from
# clipping a stop that is otherwise in the right place.
ATR_BUFFER=0.5

# ===========================================================================
# Signal
# ===========================================================================
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
# STRATEGY=confirmed needs at least 120 for divergence lookback.
BAR_COUNT=300

# ===========================================================================
# Stops and targets — only used when STRATEGY=simple
# ===========================================================================
# STRATEGY=confirmed ignores everything in this section and derives stops from
# swing structure instead. These remain for the simple strategy.
#
# READ THIS BEFORE CHANGING SL_MODE.
#
# "percent" sets the stop as a share of the entry price, so it means the same
# thing on EURUSD at 1.08 as on BTCUSD at 64000. This is the default.
#
# "points" uses raw MetaTrader points: distance = SL_PIPS * symbol.point.
# A point is not a pip. On BTCUSD (2 digits) a point is 0.01, so SL_PIPS=200
# is a TWO DOLLAR stop on a sixty-thousand-dollar instrument — hit instantly by
# the spread. On a 5-digit forex pair a point is 0.00001, so SL_PIPS=200 is 20
# pips, not 200. Only use points mode once you have checked symbol.point for
# the instrument you are trading.
#
# The bot refuses to start if the resulting stop is under MIN_STOP_PERCENT of
# price or inside three spreads.
SL_MODE=percent

# Used when SL_MODE=percent
SL_PERCENT=1.0
TP_PERCENT=2.0

# Used when SL_MODE=points
SL_PIPS=200
TP_PIPS=400

MIN_STOP_PERCENT=0.1

# ===========================================================================
# Safety
# ===========================================================================
# Once equity is this far below the day's opening, no new entries until UTC
# midnight. Open positions keep their stops.
MAX_DAILY_LOSS_PERCENT=2.0

MAX_OPEN_POSITIONS=1
POLL_SECONDS=15

# Log signals and intended orders but never send one. The safest way to watch a
# new configuration for a few days first.
DRY_RUN=false
