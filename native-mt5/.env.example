# Native MT5 — copy to .env and edit. Every value below is optional; with none
# of them set the server runs the mock adapter in read-only mode.

# --- backend ---------------------------------------------------------------
# mock     synthetic data, no broker, runs anywhere (default)
# terminal a real MetaTrader 5 terminal via the MetaTrader5 Python package
NATIVE_MT5_ADAPTER=mock

# --- what the server is allowed to do --------------------------------------
# readonly market data and account inspection only (default)
# paper    orders simulated inside the adapter, nothing reaches a broker
# live     orders reach the broker; each one needs a confirmation token
NATIVE_MT5_MODE=readonly

# --- terminal credentials (adapter=terminal) -------------------------------
# Leave blank to attach to a terminal that is already logged in.
NATIVE_MT5_LOGIN=
NATIVE_MT5_PASSWORD=
NATIVE_MT5_SERVER=
NATIVE_MT5_TERMINAL_PATH=

# --- risk caps -------------------------------------------------------------
NATIVE_MT5_MAX_RISK_PER_TRADE_PCT=1.0
NATIVE_MT5_MAX_ORDER_VOLUME=1.0
NATIVE_MT5_MAX_OPEN_POSITIONS=10
# Comma separated. Empty means every symbol the broker offers.
NATIVE_MT5_SYMBOL_ALLOWLIST=

# --- order tagging ---------------------------------------------------------
NATIVE_MT5_MAGIC=777001
NATIVE_MT5_DEVIATION_POINTS=20
